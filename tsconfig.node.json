{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/tsbuildinfo/node",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@main/*": [
        "src/main/*"
      ],
      "@ui/*": [
        "../pocketshell-core/packages/ui/src/*"
      ],
      "@pocketshell/core": [
        "../pocketshell-core/dist/esm/index.d.ts"
      ],
      "@pocketshell/core/*": [
        "../pocketshell-core/dist/esm/*"
      ]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/env.d.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "electron.vite.config.ts",
    "packages/ui/vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}