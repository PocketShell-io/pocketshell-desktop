# Standalone local PocketShell instance.
#
# This image intentionally does not use `FROM pocketshell-test:*`: the local
# instance must be buildable from a clean checkout with one Compose command.
# It contains the same SSH/SFTP/tmux/helper toolchain as the test fleet, plus
# the deterministic agent stubs and traffic responder used by the integration
# and E2E expectations.
FROM node:22-alpine3.20

ARG POCKETSHELL_VERSION=0.4.44
ARG TMUXCTL_VERSION=0.3.5

RUN apk add --no-cache \
      bash \
      curl \
      git \
      gcompat \
      iproute2 \
      libgcc \
      net-tools \
      openssh-client \
      openssh-server \
      openssh-sftp-server \
      py3-pip \
      python3 \
      tmux \
    # The Node base image already reserves UID 1000 for its `node` user. Keep
    # the fixture user at the UID used by the original Alpine image so an
    # existing named home volume remains readable after this image upgrade.
    && (deluser node 2>/dev/null || true) \
    && (delgroup node 2>/dev/null || true) \
    && adduser -D -u 1000 -s /bin/sh testuser \
    && passwd -u testuser \
    && mkdir -p /home/testuser/.ssh \
    && chmod 700 /home/testuser/.ssh \
    && python3 -m pip install --break-system-packages --no-cache-dir uv \
    && su testuser -c "uv tool install 'pocketshell==${POCKETSHELL_VERSION}' && uv tool install 'tmuxctl==${TMUXCTL_VERSION}'"

# aplexer (`a`) — the app's MAIN session manager wherever it is installed
# (src/main/helper/AplexerClient.ts); see Dockerfile.helper for why it comes
# from the GitHub release rather than PyPI, why it is unpinned by default
# (APLEXER_VERSION pins it), and the layer-cache caveat on re-fetching.
# `gcompat` + `libgcc` (installed above) run its glibc binary under musl.
# Empty ARG default: an ARG with no default is never exported into RUN, and
# `set -u` below would abort on the unset name.
ARG APLEXER_VERSION=
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64) asset_arch=amd64 ;; \
      aarch64) asset_arch=arm64 ;; \
      *) echo "no aplexer release binary for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    if [ -n "${APLEXER_VERSION}" ]; then \
      base="https://github.com/alexeygrigorev/aplexer/releases/download/v${APLEXER_VERSION}"; \
    else \
      base="https://github.com/alexeygrigorev/aplexer/releases/latest/download"; \
    fi; \
    curl -fsSL -o /usr/local/bin/a "$base/a-linux-$asset_arch"; \
    curl -fsSL -o /usr/local/bin/aplexer "$base/aplexer-linux-$asset_arch"; \
    chmod 0755 /usr/local/bin/a /usr/local/bin/aplexer

ENV HOME=/home/testuser
ENV PATH=/home/testuser/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY sshd_config /etc/ssh/sshd_config
COPY test_host_key /etc/ssh/ssh_host_ed25519_key
COPY test_key.pub /home/testuser/.ssh/authorized_keys
# These private keys are fixtures used only for this local test instance and
# its in-container healthcheck; they are not production credentials.
COPY test_key /root/test_key

RUN chmod 600 /home/testuser/.ssh/authorized_keys /root/test_key /etc/ssh/ssh_host_ed25519_key \
    && chown -R testuser:testuser /home/testuser/.ssh \
    # Alpine's sshd starts the user's shell as a login shell. Keep the helper
    # tools available to both PocketShell and a plain `ssh alias command`.
    # The real provider CLIs are optional and live in a separate named volume;
    # make that volume's bin directory visible to login shells only when the
    # opt-in flag is enabled. The default image must continue to use stubs.
    && printf '%s\n' \
      'case "${POCKETSHELL_REAL_AGENTS:-false}" in' \
      '  true|1|yes|TRUE|YES) export PATH="/home/testuser/.agent-tools/bin:/home/testuser/.local/bin:$PATH" ;;' \
      '  *) export PATH="/home/testuser/.local/bin:$PATH" ;;' \
      'esac' >> /etc/profile

COPY fixtures/ /opt/pocketshell-fixtures/
COPY traffic-server.py /usr/local/bin/ps-traffic-server
COPY helper-entrypoint.sh /usr/local/bin/pocketshell-helper-entrypoint
COPY instance-entrypoint.sh /usr/local/bin/pocketshell-instance-entrypoint
COPY install-real-agents.sh /usr/local/bin/pocketshell-install-real-agents
COPY tmux.conf /opt/pocketshell-tmux.conf

COPY agent-bin/ /usr/local/bin/

# Keep the default image deterministic and credential-free. A local developer
# opts into the real provider CLIs at runtime; their npm package tree belongs
# to the named agent volume, so image rebuilds cannot discard it.
RUN chmod +x \
      /usr/local/bin/claude \
      /usr/local/bin/codex \
      /usr/local/bin/opencode \
      /usr/local/bin/quse \
      /usr/local/bin/ps-traffic-server \
      /usr/local/bin/pocketshell-helper-entrypoint \
      /usr/local/bin/pocketshell-instance-entrypoint \
      /usr/local/bin/pocketshell-install-real-agents

EXPOSE 22 8021

CMD ["/usr/local/bin/pocketshell-instance-entrypoint"]
