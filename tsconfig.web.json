{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "outDir": "out/tsbuildinfo/web",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@ui/*": ["../pocketshell-core/packages/ui/src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.vue",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.vue",
    "src/shared/**/*.ts"
  ]
}
