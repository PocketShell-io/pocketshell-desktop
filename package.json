{
  "name": "pocketshell-desktop",
  "version": "0.1.3",
  "description": "Desktop (Electron) port of PocketShell — a tmux-native, agent-aware SSH client.",
  "license": "MIT",
  "author": "Alexey Grigorev <alexey.s.grigoriev@gmail.com>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run icon && electron-vite dev",
    "build": "npm run icon && electron-vite build",
    "preview": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "dist": "npm run build && electron-builder --publish never",
    "test:coverage": "vitest run tests/unit --coverage"
  },
  "//dependencies": "WHAT SHIPS. electron-builder copies production `dependencies` into the installer's node_modules and leaves `devDependencies` behind, so this list means `require()`d from disk at runtime — NOT `import`ed anywhere. Everything the renderer imports is bundled into out/renderer by Vite and belongs below; putting it here duplicates megabytes of already-bundled source into every installer (that was CodeMirror, ~22 MB of package tree). tests/unit/packagedDependencies.test.ts fails if this list grows without a reason being written down.",
  "dependencies": {
    "ssh2": "1.16.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@eslint/js": "9.17.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "electron-store": "10.0.1",
    "electron-vite": "3.1.0",
    "eslint": "9.17.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "marked": "18.0.11",
    "pinia": "2.3.0",
    "playwright": "1.49.1",
    "testcontainers": "10.17.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.67.0",
